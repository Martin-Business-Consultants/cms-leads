<% @page_title = "Unsubscribe" %>
<section class="panel panel--padded stack measure--sm measure--centered">
  <% if @lead.unsubscribed? %>
    <h1 class="title">You’re unsubscribed</h1>
    <p class="text-body">We won’t send you any more of these emails. If you write to us, we’ll still answer.</p>
  <% else %>
    <h1 class="title">Stop these emails?</h1>
    <p class="text-body">You’ll get no more follow-up emails from us at <%= @lead.email %>.</p>
    <%= button_to "Unsubscribe", leads_mail_unsubscribe_path(token: params[:token]), class: "btn btn--primary", form_class: "contents" %>
  <% end %>
</section>
