<%# A playbook's email to a lead: the step's words, then (for a lead's copy) the
    unsubscribe line and the open pixel. Inline styles: email clients don't
    load the admin's. %>
<div style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;font-size:15px;line-height:1.6;color:#1c1917;max-width:560px;">
  <%= @body_html %>
  <% if @unsubscribe_url %>
    <p style="margin:32px 0 0;font-size:12px;color:#8a8c93;">
      Rather not hear from us? <a href="<%= @unsubscribe_url %>" style="color:#8a8c93;">Unsubscribe</a>.
    </p>
    <%= image_tag @open_url, width: 1, height: 1, alt: "", style: "display:block;border:0;width:1px;height:1px;" %>
  <% end %>
</div>
