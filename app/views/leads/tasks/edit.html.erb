<% @page_title = @task.title %>
<%= parent_page @task.lead.display_name, lead_path(@task.lead) %>
<%# A task's editor: what as the title, then the rest; when and who beside it. %>
<%= form_with model: @task, url: leads_task_path(@task), scope: :task, id: "task_form", class: "editor" do |form| %>
  <div class="editor__main">
    <div>
      <label class="visually-hidden" for="task_title">What</label>
      <%= form.text_field :title, required: true, class: "title-input", placeholder: "What to do" %>
    </div>
    <%= render "layouts/shared/errors", record: @task %>
    <%= postbox "task-details", "For #{@task.lead.display_name}" do %>
      <%= settings_field "Kind" do %>
        <%= form.select :kind, lead_task_kind_options %>
      <% end %>
      <%= settings_field "Notes" do %>
        <%= form.text_area :notes, rows: 4 %>
      <% end %>
    <% end %>
  </div>
  <aside class="editor__aside">
    <% timing = capture do %>
      <div class="fields">
        <%= settings_field "Due", hint: "In the site’s time zone." do %>
          <%= form.datetime_local_field :due_at, value: @task.due_at&.in_time_zone(Site.time_zone)&.strftime("%Y-%m-%dT%H:%M") %>
        <% end %>
        <%= settings_field "Who" do %>
          <%= form.select :assignee_id, [["Nobody yet", ""]] + lead_people_options %>
        <% end %>
      </div>
    <% end %>
    <%= render "layouts/shared/save_box", key: "task-save", button: "Save changes", extra: timing,
          trash_name: "this step", trash_path: leads_task_path(@task), trash_form: "task_delete_form", trash_label: "Drop",
          trash_message: "It comes off the lead’s plan; the timeline notes it." %>
  </aside>
<% end %>
<%= render "layouts/shared/delete_form", id: "task_delete_form", path: leads_task_path(@task) %>
