<%# The morning digest: tasks due by tonight, overdue first, and open leads
    with nothing planned, each linked. Inline styles: email clients don't
    load the admin's. %>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f7f7f5;padding:24px 0;">
  <tr>
    <td align="center">
      <table role="presentation" width="560" cellpadding="0" cellspacing="0" style="background:#ffffff;border:1px solid #e7e5e4;border-radius:8px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;color:#1c1917;">
        <tr>
          <td style="padding:24px 32px 8px;">
            <h1 style="margin:0;font-size:20px;">Leads today</h1>
            <p style="margin:4px 0 0;font-size:14px;color:#57534e;"><%= @now.to_date.to_fs(:long) %></p>
          </td>
        </tr>
        <% if @tasks.any? %>
          <tr><td style="padding:16px 32px 0;font-size:12px;letter-spacing:0.04em;text-transform:uppercase;color:#78716c;">To do</td></tr>
          <% @tasks.each do |task| %>
            <%# herb:key task.id %>
            <tr>
              <td style="padding:8px 32px;font-size:14px;line-height:1.5;border-bottom:1px solid #f0efed;">
                <a href="<%= lead_url(task.lead) %>" style="color:#1c1917;font-weight:600;text-decoration:none;"><%= task.lead.display_name %></a>
                — <%= task.title %>
                <% if task.due_at %>
                  <span style="color:<%= task.overdue? ? "#b91c1c" : "#78716c" %>;"> · <%= task.overdue? ? "overdue, " : "" %>due <%= lead_due_words(task.due_at) %></span>
                <% end %>
              </td>
            </tr>
          <% end %>
        <% end %>
        <% if @leads.any? %>
          <tr><td style="padding:16px 32px 0;font-size:12px;letter-spacing:0.04em;text-transform:uppercase;color:#78716c;">Nothing planned</td></tr>
          <% @leads.each do |lead| %>
            <%# herb:key lead.id %>
            <tr>
              <td style="padding:8px 32px;font-size:14px;line-height:1.5;border-bottom:1px solid #f0efed;">
                <a href="<%= lead_url(lead) %>" style="color:#1c1917;font-weight:600;text-decoration:none;"><%= lead.display_name %></a>
                <span style="color:#78716c;"> · <%= lead.stage.humanize %>: decide the next step</span>
              </td>
            </tr>
          <% end %>
        <% end %>
        <tr>
          <td style="padding:20px 32px 24px;">
            <a href="<%= leads_queue_url %>" style="display:inline-block;background:#1c1917;color:#ffffff;text-decoration:none;padding:10px 16px;border-radius:6px;font-weight:600;">Open Needs you</a>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
